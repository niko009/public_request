---
import '../styles/global.css';
const { title='bacus.dev — продукты, эксперименты и ИИ', description='Личная лаборатория программных продуктов, экспериментов с ИИ и технологий.', pageType='website' } = Astro.props;
const siteVersion='0.4.1';
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><meta name="description" content={description}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={pageType}/><link rel="icon" href="/logo-mark.svg" type="image/svg+xml"/><title>{title}</title></head><body>
<header class="site-header"><a class="brand" href="/"><span class="brand-mark"><img src="/logo-mark.svg" width="35" height="35" alt=""/></span><span class="brand-word">bacus<span>.dev</span></span></a><nav class="nav"><a href="/">Главная</a><a href="/projects/">Проекты</a><a href="/about/">Обо мне</a></nav></header>
<main id="main-content"><slot /></main>
<footer class="footer"><div class="footer-brand"><strong>bacus.dev</strong><span>Личная лаборатория продуктов и ИИ · Версия v{siteVersion}</span></div><div class="footer-links"><a href="https://github.com/niko009">GitHub ↗</a><a href="mailto:mihail@bacus.dev">Email ↗</a><a href="/privacy/">Конфиденциальность</a></div></footer>
</body></html>
