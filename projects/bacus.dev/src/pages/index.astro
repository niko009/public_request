---
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredProjects, projects } from '../data/projects';
const liveCount = projects.filter((project) => Boolean(project.liveUrl)).length;
const technologyCount = new Set(projects.flatMap((project) => project.stack)).size;
---
<BaseLayout title="bacus.dev — продукты, эксперименты и ИИ" description="Личная лаборатория: небольшие продукты, автоматизация, эксперименты с ИИ и новые технологии.">
  <section class="section shell page-intro reveal">
    <div class="eyebrow">research → prototype → refine</div>
    <h1>Довожу интересные идеи до состояния «работает».</h1>
    <p><strong>bacus.dev</strong> — моя личная лаборатория: небольшие продукты, автоматизация, эксперименты с ИИ и новые технологии.</p>
    <div class="hero-proof"><div><strong>{projects.length}</strong><span>проектов</span></div><div><strong>{liveCount}</strong><span>онлайн</span></div><div><strong>{technologyCount}+</strong><span>технологий</span></div></div>
  </section>
  <section class="section shell" id="projects"><div class="section-heading"><div><div class="eyebrow">Проекты</div><h2>То, что можно открыть.</h2></div><a class="text-link" href="/projects/">Все проекты →</a></div><div class="project-grid">{featuredProjects.map((project) => <article class="project-card"><div class="project-card-top"><span class="status">{project.status}</span><span class="arrow">↗</span></div><h3><a href={`/projects/${project.slug}/`}>{project.name}</a></h3><p>{project.summaryRu}</p><div class="tags">{project.stack.slice(0,4).map((item) => <span>{item}</span>)}</div></article>)}</div></section>
</BaseLayout>
