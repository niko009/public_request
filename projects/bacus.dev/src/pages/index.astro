    @media(max-width:680px){.upload-shell{width:calc(100% - 32px)}body:has(.upload-home) .site-header{padding-left:16px;padding-right:16px}.upload-hero{min-height:auto;padding:122px 0 80px}.hero-title{font-size:clamp(2.85rem,13vw,4.5rem)}.hero-copy{font-size:.9rem}.hero-actions>a{flex:1;justify-content:center;min-width:145px}.hero-metrics{display:grid;grid-template-columns:repeat(3,1fr)}.hero-metrics div{min-width:0;padding:10px}.scroll-cue{display:none}.upload-section{padding:72px 0}.section-heading{margin-bottom:34px}.projects-grid,.process-grid,.tech-grid{grid-template-columns:1fr}.stats-grid{grid-template-columns:repeat(2,1fr)}.project-card{min-height:300px}.lab-finale{padding:82px 0 62px}.custom-cursor{display:none}}
    @media(prefers-reduced-motion:reduce){.lab-grid,.hero-live-dot,.process-line span,.process-dot,.scroll-cue i{animation:none!important}.hero-title .word,.hero-animate,.reveal-item{opacity:1!important;filter:none!important;transform:none!important;animation:none!important;transition:none!important}.custom-cursor,.hero-3d-canvas{display:none!important}.project-card{transform:none!important}}
    @media(max-width:680px){.hero-3d-canvas{opacity:.35}}
  </style>

  <script is:inline>
    (() => {
      const root = document.querySelector('.upload-home');
      if (!root) return;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const coarse = matchMedia('(pointer:coarse)').matches;

      const header = document.querySelector('.site-header');
      const updateHeader = () => header?.classList.toggle('is-scrolled', scrollY > 20);
      addEventListener('scroll', updateHeader, { passive: true });
      updateHeader();

      const items = [...document.querySelectorAll('.reveal-item')];
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((item) => item.classList.add('visible'));
      } else {
        const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }), { threshold:.1, rootMargin:'0px 0px -50px' });
        items.forEach((item) => observer.observe(item));
      }

      document.querySelectorAll('[data-counter]').forEach((element) => {
        const target = Number(element.getAttribute('data-counter') || 0);
        const suffix = element.getAttribute('data-suffix') || '';
        let started = false;
        const run = () => {
          if (started) return;
          started = true;
          if (reduce) { element.textContent = `${target}${suffix}`; return; }
          const start = performance.now();
          const duration = 1100;
          const tick = (now) => {
            const progress = Math.min(1,(now-start)/duration);
            const eased = 1-Math.pow(1-progress,3);
            element.textContent = `${Math.round(target*eased)}${suffix}`;
            if (progress < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        if (!('IntersectionObserver' in window)) run();
        else new IntersectionObserver((entries, observer) => entries.forEach((entry) => { if(entry.isIntersecting){ run(); observer.disconnect(); } }), { threshold:.5 }).observe(element);
      });

      if (!coarse && !reduce) {
        const cursor = document.getElementById('custom-cursor');
        let x = -100, y = -100, tx = -100, ty = -100;
        const render = () => {
          x += (tx-x)*.2; y += (ty-y)*.2;
          if (cursor) { cursor.style.left=`${x}px`; cursor.style.top=`${y}px`; }
          requestAnimationFrame(render);
        };
        render();
        addEventListener('pointermove',(event) => {
          tx=event.clientX; ty=event.clientY;
          cursor?.classList.add('visible');
          const interactive = event.target?.closest?.('a,button,.project-card,.process-card,.tech-card,.stat-card');
          cursor?.classList.toggle('pointer',Boolean(interactive));
          document.documentElement.style.setProperty('--lab-mouse-x',`${(event.clientX/innerWidth-.5)*30}px`);
          document.documentElement.style.setProperty('--lab-mouse-y',`${(event.clientY/innerHeight-.5)*30}px`);
        },{ passive:true });
        document.addEventListener('mouseleave',()=>cursor?.classList.remove('visible'));

        const one = document.querySelector('.glow-one');
        const two = document.querySelector('.glow-two');
        addEventListener('pointermove',(event) => {
          const ox=(event.clientX/innerWidth-.5)*28;
          const oy=(event.clientY/innerHeight-.5)*28;
          if(one) one.style.transform=`translate(${ox}px,${oy}px)`;
          if(two) two.style.transform=`translate(${-ox}px,${-oy}px)`;
        },{ passive:true });

        // 3D tilt on project cards
        document.querySelectorAll('.project-card:not(.all-projects)').forEach((card) => {
          let frame = 0;
          card.addEventListener('pointermove', (e) => {
            if (frame) cancelAnimationFrame(frame);
            frame = requestAnimationFrame(() => {
              const rect = card.getBoundingClientRect();
              const px = (e.clientX - rect.left) / rect.width - 0.5;
              const py = (e.clientY - rect.top) / rect.height - 0.5;
              card.classList.add('is-tilting');
              card.style.transform = `perspective(1000px) rotateY(${px * 12}deg) rotateX(${-py * 10}deg) translateY(-6px) scale(1.02)`;
            });
          }, { passive: true });
          card.addEventListener('pointerleave', () => {
            card.classList.remove('is-tilting');
            card.style.transform = '';
          });
        });

        // Magnetic buttons
        document.querySelectorAll('.btn-primary, .btn-ghost').forEach((btn) => {
          btn.addEventListener('pointermove', (e) => {
            const rect = btn.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            btn.style.transform = `translate(${x * 0.22}px, ${y * 0.22}px)`;
          }, { passive: true });
          btn.addEventListener('pointerleave', () => {
            btn.style.transform = '';
          });
        });
      }

      // Load Three.js + inline hero scene (no dependency on /scripts/ path)
      if (!reduce && !coarse && document.getElementById('hero-3d-canvas')) {
        const bootHero3D = () => {
          if (typeof THREE === 'undefined') return;
          if (typeof window.initBacusHero3D === 'function') {
            window.initBacusHero3D();
            return;
          }
          // Inline fallback scene (works even if /scripts/hero-3d.js is 404)
          const canvas = document.getElementById('hero-3d-canvas');
          if (!canvas || canvas.dataset.hero3dReady === '1') return;
          canvas.dataset.hero3dReady = '1';
          const scene = new THREE.Scene();
          const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 100);
          camera.position.set(0, 0.15, 3.6);
          const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'high-performance' });
          renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 2));
          renderer.setClearColor(0x000000, 0);
          scene.add(new THREE.AmbientLight(0x00e5cc, 0.35));
          const key = new THREE.PointLight(0x00e5cc, 2.2, 20); key.position.set(2.2, 2.4, 3.2); scene.add(key);
          const fill = new THREE.PointLight(0x80ffe2, 0.9, 16); fill.position.set(-2.8, -0.6, 2.4); scene.add(fill);
          const group = new THREE.Group(); scene.add(group);
          const m1 = new THREE.MeshBasicMaterial({ color: 0x00e5cc, wireframe: true, transparent: true, opacity: 0.55 });
          const m2 = new THREE.MeshBasicMaterial({ color: 0x80ffe2, wireframe: true, transparent: true, opacity: 0.32 });
          const m3 = new THREE.MeshBasicMaterial({ color: 0xa3ffd6, wireframe: true, transparent: true, opacity: 0.4 });
          const torus = new THREE.Mesh(new THREE.TorusGeometry(1.15, 0.28, 16, 64), m1); torus.position.set(-1.25, 0.25, -0.2); group.add(torus);
          const icosa = new THREE.Mesh(new THREE.IcosahedronGeometry(0.95, 1), m2); icosa.position.set(1.45, -0.1, 0.15); group.add(icosa);
          const octa = new THREE.Mesh(new THREE.OctahedronGeometry(0.62, 0), m3); octa.position.set(0.05, 1.05, -0.65); group.add(octa);
          const box = new THREE.Mesh(new THREE.BoxGeometry(0.75, 0.75, 0.75), m2); box.position.set(-0.15, -0.95, 0.45); group.add(box);
          const ring = new THREE.Mesh(new THREE.TorusGeometry(0.55, 0.06, 12, 48), m1); ring.position.set(0.9, 0.85, -0.3); ring.rotation.x = Math.PI / 2.4; group.add(ring);
          const n = 140, pos = new Float32Array(n * 3);
          for (let i = 0; i < n; i++) { pos[i*3] = (Math.random()-0.5)*9; pos[i*3+1] = (Math.random()-0.5)*5.5; pos[i*3+2] = (Math.random()-0.5)*5-0.5; }
          const pGeo = new THREE.BufferGeometry(); pGeo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
          const particles = new THREE.Points(pGeo, new THREE.PointsMaterial({ color: 0x00e5cc, size: 0.045, transparent: true, opacity: 0.7, sizeAttenuation: true }));
          scene.add(particles);
          let mx = 0, my = 0, tx = 0, ty = 0, raf = 0, running = true;
          const resize = () => {
            const p = canvas.parentElement || document.body;
            const w = p.clientWidth || innerWidth, h = p.clientHeight || innerHeight;
            camera.aspect = w / Math.max(h, 1); camera.updateProjectionMatrix(); renderer.setSize(w, h, false);
          };
          const onPointer = (e) => { tx = (e.clientX / innerWidth - 0.5) * 2; ty = (e.clientY / innerHeight - 0.5) * 2; };
          const animate = (t) => {
            if (!running) return; raf = requestAnimationFrame(animate);
            const time = t * 0.001; mx += (tx - mx) * 0.05; my += (ty - my) * 0.05;
            group.rotation.y = time * 0.14 + mx * 0.35; group.rotation.x = Math.sin(time * 0.2) * 0.14 + my * 0.2;
            torus.rotation.x = time * 0.4; torus.rotation.z = time * 0.25;
            icosa.rotation.y = -time * 0.32; icosa.rotation.x = time * 0.18;
            octa.rotation.y = time * 0.5; box.rotation.x = time * 0.22; box.rotation.y = -time * 0.28; ring.rotation.z = time * 0.35;
            particles.rotation.y = time * 0.05; particles.rotation.x = Math.sin(time * 0.12) * 0.06;
            camera.position.x = mx * 0.45; camera.position.y = 0.15 - my * 0.25; camera.lookAt(0, 0, 0);
            renderer.render(scene, camera);
          };
          addEventListener('resize', resize, { passive: true });
          addEventListener('pointermove', onPointer, { passive: true });
          document.addEventListener('visibilitychange', () => { if (document.hidden) { running = false; cancelAnimationFrame(raf); } else { running = true; resize(); raf = requestAnimationFrame(animate); } });
          resize(); raf = requestAnimationFrame(animate); canvas.classList.add('is-ready');
        };

        const loadThree = () => {
          if (window.THREE) { bootHero3D(); return; }
          const three = document.createElement('script');
          // 0.160 still ships UMD three.min.js (0.170+ path breaks)
          three.src = 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js';
          three.crossOrigin = 'anonymous';
          three.onload = () => {
            // Prefer external script if available, else inline fallback
            const s = document.createElement('script');
            s.src = '/scripts/hero-3d.js';
            s.onload = () => bootHero3D();
            s.onerror = () => bootHero3D();
            document.body.appendChild(s);
            // Safety timeout if script hangs
            setTimeout(bootHero3D, 1200);
          };
          three.onerror = () => console.warn('[bacus] Three.js CDN failed');
          document.head.appendChild(three);
        };
        if ('requestIdleCallback' in window) requestIdleCallback(loadThree, { timeout: 1200 });
        else setTimeout(loadThree, 400);
      }
    })();
  </script>
</BaseLayout>
