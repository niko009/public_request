---
const { project } = Astro.props;
const statusClass = project.status.toLowerCase().replaceAll(' ', '-');
const statusRu = project.status === 'Active' ? 'Активен' : project.status === 'In development' ? 'В разработке' : 'Прототип';
const previewLabelRu = `Открыть страницу проекта ${project.name}`;
const previewLabelEn = `Open ${project.name} project page`;
---
<article class={`project-card project-${project.slug}`} data-tilt-card>
  <div class="project-card-top">
    <span class={`status ${statusClass}`} data-en={project.status} data-ru={statusRu}>{statusRu}</span>
    <span class="arrow" aria-hidden="true">↗</span>
  </div>

  <a
    class="project-preview"
    href={`/projects/${project.slug}/`}
    aria-label={previewLabelRu}
    data-en-aria-label={previewLabelEn}
    data-ru-aria-label={previewLabelRu}
    style={`view-transition-name: project-preview-${project.slug}`}
  >
    <div class={`preview-scene preview-${project.slug}`} aria-hidden="true">
      {project.slug === 'motion-play' && (
        <>
          <div class="motion-tv">
            <div class="motion-person"><span></span><i class="arm left"></i><i class="arm right"></i><i class="leg left"></i><i class="leg right"></i></div>
            <div class="motion-floor"></div>
          </div>
          <div class="motion-phone"><span class="camera-dot"></span><span class="phone-scan"></span></div>
          <span class="signal-ring ring-one"></span><span class="signal-ring ring-two"></span>
          <span class="preview-caption">BODY → PLAY</span>
        </>
      )}

      {project.slug === 'nutriguru' && (
        <>
          <div class="nutri-window">
            <div class="mini-topbar"><span></span><span></span><span></span><b>NutriGuru</b></div>
            <div class="nutri-body">
              <div class="macro-ring"><strong>82%</strong><small>день</small></div>
              <div class="meal-list"><span></span><span></span><span></span><span></span></div>
            </div>
            <div class="ai-chip">AI · plan assistant</div>
          </div>
          <span class="preview-caption">PLAN · TRACK · ADAPT</span>
        </>
      )}

      {project.slug === 'eye-gym' && (
        <>
          <div class="eye-target"><span class="eye-iris"><i></i></span></div>
          <div class="eye-timer"><small>FOCUS</small><strong>00:28</strong></div>
          <div class="eye-path"><span></span></div>
          <span class="preview-caption">FOLLOW THE TARGET</span>
        </>
      )}

      {project.slug === 'san-teh' && (
        <>
          <div class="santeh-window">
            <div class="santeh-hero"><span>Сантехнические работы</span><b>Быстро · аккуратно · понятно</b></div>
            <div class="santeh-services"><span></span><span></span><span></span></div>
          </div>
          <div class="pipe pipe-a"></div><div class="pipe pipe-b"></div><span class="water-drop"></span>
          <span class="preview-caption">SERVICE → RESULT</span>
        </>
      )}

      {project.slug === 'alcocalc' && (
        <>
          <div class="bac-window">
            <div class="bac-stat"><small>BAC</small><strong>0.42‰</strong><span>↓ 0.08 / h</span></div>
            <svg class="bac-chart" viewBox="0 0 220 90" role="presentation">
              <path class="chart-grid" d="M0 70 H220 M0 45 H220 M0 20 H220" />
              <path class="chart-line" d="M0 72 C30 67 40 30 70 34 S108 66 138 52 S173 26 220 18" />
            </svg>
            <div class="drink-chips"><span>Beer</span><span>Wine</span><span>+ drink</span></div>
          </div>
          <span class="preview-caption">TRACK · ESTIMATE · PLAN</span>
        </>
      )}

      {!['motion-play', 'nutriguru', 'eye-gym', 'san-teh', 'alcocalc'].includes(project.slug) && (
        <>
          <div class="generic-preview"><span></span><span></span><span></span><span></span></div>
          <span class="preview-caption">BACUS LAB PROJECT</span>
        </>
      )}
    </div>
  </a>

  <h3 style={`view-transition-name: project-${project.slug}`}>
    <a href={`/projects/${project.slug}/`}>{project.name}</a>
  </h3>

  <p data-en={project.summaryEn} data-ru={project.summaryRu}>{project.summaryRu}</p>
  <div class="tags">{project.stack.slice(0,4).map((item) => <span>{item}</span>)}</div>

  <div class="project-actions">
    <a class="card-link" href={`/projects/${project.slug}/`} data-en="Details" data-ru="Подробнее">Подробнее</a>
    {project.liveUrl && <a class="card-link live-link" href={project.liveUrl} target="_blank" rel="noreferrer" data-en="Open project ↗" data-ru="Открыть проект ↗">Открыть проект ↗</a>}
  </div>
</article>

<style>
  .project-card-top{margin-bottom:14px}
  .project-preview{
    display:block;
    position:relative;
    margin-bottom:22px;
    aspect-ratio:16/9;
    border:1px solid var(--line);
    border-radius:17px;
    overflow:hidden;
    background:rgba(255,255,255,.018);
    transform:translateZ(22px);
    box-shadow:inset 0 1px rgba(255,255,255,.045);
  }
  .project-preview:focus-visible{outline:3px solid var(--accent2);outline-offset:3px}
  .preview-scene{position:absolute;inset:0;overflow:hidden;transition:transform .6s var(--ease-out),filter .4s ease}
  .project-card:hover .preview-scene,.project-card.is-pointed .preview-scene{transform:scale(1.035)}
  .preview-scene::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(120deg,transparent 35%,rgba(255,255,255,.09),transparent 58%);transform:translateX(-120%);transition:transform .8s var(--ease-out)}
  .project-card:hover .preview-scene::after,.project-card.is-pointed .preview-scene::after{transform:translateX(120%)}
  .preview-caption{position:absolute;left:12px;bottom:10px;z-index:8;color:rgba(244,247,251,.62);font-size:.56rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase}

  .preview-motion-play{background:radial-gradient(circle at 22% 20%,rgba(102,227,255,.18),transparent 28%),linear-gradient(145deg,#08131c,#09101a 55%,#12112a)}
  .motion-tv{position:absolute;left:9%;top:13%;width:61%;height:66%;border:1px solid rgba(102,227,255,.26);border-radius:13px;background:linear-gradient(180deg,rgba(102,227,255,.06),rgba(255,255,255,.015));box-shadow:0 14px 30px rgba(0,0,0,.25)}
  .motion-tv::before{content:"LIVE POSE";position:absolute;left:10px;top:8px;color:rgba(102,227,255,.72);font-size:.48rem;font-weight:850;letter-spacing:.12em}
  .motion-floor{position:absolute;left:15%;right:15%;bottom:15%;height:1px;background:linear-gradient(90deg,transparent,rgba(102,227,255,.38),transparent)}
  .motion-person{position:absolute;left:50%;top:50%;width:10px;height:43px;transform:translate(-50%,-40%);background:linear-gradient(var(--accent),var(--accent3));border-radius:99px;box-shadow:0 0 18px rgba(102,227,255,.18)}
  .motion-person span{position:absolute;width:17px;height:17px;left:50%;top:-15px;transform:translateX(-50%);border:2px solid var(--accent);border-radius:50%}
  .motion-person i{position:absolute;display:block;width:3px;height:30px;top:7px;background:var(--accent);border-radius:99px;transform-origin:top}
  .motion-person .arm.left{left:2px;transform:rotate(54deg)} .motion-person .arm.right{right:2px;transform:rotate(-54deg)}
  .motion-person .leg.left{left:3px;top:33px;transform:rotate(20deg)} .motion-person .leg.right{right:3px;top:33px;transform:rotate(-20deg)}
  .motion-phone{position:absolute;right:10%;bottom:12%;width:24%;height:58%;border:1px solid rgba(255,255,255,.22);border-radius:13px;background:linear-gradient(180deg,#141a25,#0b0f16);box-shadow:0 16px 28px rgba(0,0,0,.28);transform:rotate(5deg)}
  .motion-phone::before{content:"CAM";position:absolute;left:8px;top:8px;color:var(--muted);font-size:.48rem;letter-spacing:.12em}
  .camera-dot{position:absolute;right:7px;top:8px;width:5px;height:5px;border-radius:50%;background:var(--accent2);box-shadow:0 0 9px rgba(163,255,115,.7)}
  .phone-scan{position:absolute;left:12%;right:12%;top:25%;height:1px;background:linear-gradient(90deg,transparent,var(--accent2),transparent);animation:phone-scan 3.2s ease-in-out infinite}
  .signal-ring{position:absolute;right:24%;top:42%;width:33px;height:33px;border:1px solid rgba(102,227,255,.24);border-radius:50%;animation:signal-pop 2.7s ease-out infinite}.ring-two{animation-delay:1.1s}

  .preview-nutriguru{background:radial-gradient(circle at 78% 12%,rgba(163,255,115,.17),transparent 28%),linear-gradient(145deg,#08130f,#0e1715 58%,#111522)}
  .nutri-window{position:absolute;inset:11% 9% 15%;border:1px solid rgba(163,255,115,.18);border-radius:13px;background:rgba(11,18,17,.92);box-shadow:0 18px 34px rgba(0,0,0,.23)}
  .mini-topbar{height:25%;display:flex;align-items:center;gap:4px;padding:0 9px;border-bottom:1px solid rgba(255,255,255,.08)}
  .mini-topbar span{width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.22)} .mini-topbar b{margin-left:auto;font-size:.48rem;color:rgba(244,247,251,.64)}
  .nutri-body{height:58%;display:grid;grid-template-columns:.72fr 1.28fr;gap:10px;align-items:center;padding:8px 10px}
  .macro-ring{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;align-content:center;background:conic-gradient(var(--accent2) 0 82%,rgba(255,255,255,.07) 82%);position:relative}
  .macro-ring::after{content:"";position:absolute;inset:5px;border-radius:50%;background:#0d1514}.macro-ring strong,.macro-ring small{position:relative;z-index:2}.macro-ring strong{font-size:.66rem}.macro-ring small{font-size:.42rem;color:var(--muted)}
  .meal-list{display:grid;gap:5px}.meal-list span{height:7px;border-radius:99px;background:linear-gradient(90deg,rgba(163,255,115,.34),rgba(255,255,255,.06))}.meal-list span:nth-child(2){width:78%}.meal-list span:nth-child(3){width:88%}.meal-list span:nth-child(4){width:64%}
  .ai-chip{position:absolute;right:9px;bottom:7px;padding:4px 7px;border:1px solid rgba(102,227,255,.16);border-radius:999px;color:rgba(102,227,255,.75);font-size:.44rem;background:rgba(102,227,255,.05)}

  .preview-eye-gym{background:radial-gradient(circle at 50% 48%,rgba(102,227,255,.16),transparent 30%),linear-gradient(145deg,#081317,#0d171a 55%,#101626)}
  .eye-target{position:absolute;left:15%;top:20%;width:48%;height:47%;display:grid;place-items:center;border:1px solid rgba(102,227,255,.2);border-radius:70% 20% 70% 20%;transform:rotate(-5deg);background:rgba(102,227,255,.03)}
  .eye-iris{width:44px;height:44px;border-radius:50%;border:1px solid rgba(102,227,255,.42);display:grid;place-items:center;box-shadow:0 0 24px rgba(102,227,255,.12)}.eye-iris i{width:13px;height:13px;border-radius:50%;background:var(--accent);box-shadow:0 0 16px rgba(102,227,255,.55);animation:eye-focus 4s ease-in-out infinite}
  .eye-timer{position:absolute;right:11%;top:22%;display:grid;gap:2px}.eye-timer small{font-size:.45rem;letter-spacing:.12em;color:var(--accent2)}.eye-timer strong{font-size:1rem;letter-spacing:-.04em}
  .eye-path{position:absolute;right:13%;bottom:24%;width:25%;height:1px;background:rgba(255,255,255,.1)}.eye-path span{position:absolute;width:6px;height:6px;top:-3px;border-radius:50%;background:var(--accent2);box-shadow:0 0 10px rgba(163,255,115,.55);animation:eye-path 3.2s ease-in-out infinite}

  .preview-san-teh{background:radial-gradient(circle at 88% 18%,rgba(102,227,255,.2),transparent 28%),linear-gradient(145deg,#07131b,#0c1821 58%,#0f1f28)}
  .santeh-window{position:absolute;left:7%;right:22%;top:11%;bottom:14%;border:1px solid rgba(255,255,255,.16);border-radius:12px;overflow:hidden;background:#0d1720;box-shadow:0 15px 30px rgba(0,0,0,.22)}
  .santeh-hero{height:58%;padding:11px;background:linear-gradient(135deg,rgba(102,227,255,.2),rgba(255,255,255,.025));display:flex;flex-direction:column;justify-content:flex-end}.santeh-hero span{font-size:.62rem;font-weight:850}.santeh-hero b{margin-top:3px;color:var(--muted);font-size:.43rem;font-weight:600}
  .santeh-services{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;padding:7px}.santeh-services span{height:19px;border-radius:5px;background:linear-gradient(180deg,rgba(255,255,255,.08),rgba(255,255,255,.025))}
  .pipe{position:absolute;right:8%;border:5px solid rgba(102,227,255,.5)}.pipe-a{top:17%;width:23%;height:35%;border-left:0;border-bottom:0;border-radius:0 18px 0 0}.pipe-b{right:7%;top:48%;width:13%;height:32%;border-right:0;border-top:0;border-radius:0 0 0 18px}.water-drop{position:absolute;right:4.5%;bottom:14%;width:9px;height:12px;border-radius:60% 40% 60% 40%;background:var(--accent);transform:rotate(45deg);box-shadow:0 0 12px rgba(102,227,255,.6);animation:drop-pulse 2s ease-in-out infinite}

  .preview-alcocalc{background:radial-gradient(circle at 84% 18%,rgba(148,135,255,.18),transparent 30%),linear-gradient(145deg,#0d0d17,#12111e 56%,#111821)}
  .bac-window{position:absolute;inset:10% 8% 15%;border:1px solid rgba(148,135,255,.2);border-radius:12px;background:rgba(13,13,23,.9);padding:10px}.bac-stat{display:grid;grid-template-columns:auto 1fr auto;align-items:end;gap:7px}.bac-stat small{font-size:.45rem;color:var(--muted)}.bac-stat strong{font-size:1rem;letter-spacing:-.04em}.bac-stat span{font-size:.45rem;color:var(--accent2)}
  .bac-chart{width:100%;height:48%;margin-top:5px;overflow:visible}.chart-grid{fill:none;stroke:rgba(255,255,255,.06);stroke-width:1}.chart-line{fill:none;stroke:var(--accent3);stroke-width:3;stroke-linecap:round;stroke-dasharray:310;stroke-dashoffset:0;filter:drop-shadow(0 0 5px rgba(148,135,255,.35));animation:chart-breathe 4s ease-in-out infinite}
  .drink-chips{display:flex;gap:4px;margin-top:3px}.drink-chips span{padding:3px 5px;border:1px solid rgba(255,255,255,.08);border-radius:999px;color:var(--muted);font-size:.4rem}

  .generic-preview{position:absolute;inset:18%;display:grid;grid-template-columns:1fr 1fr;gap:7px}.generic-preview span{border:1px solid var(--line);border-radius:10px;background:rgba(255,255,255,.035)}

  @keyframes phone-scan{0%,100%{transform:translateY(0);opacity:.3}50%{transform:translateY(66px);opacity:.9}}
  @keyframes signal-pop{0%{transform:scale(.4);opacity:.75}100%{transform:scale(1.9);opacity:0}}
  @keyframes eye-focus{0%,100%{transform:translate(-7px,-4px)}25%{transform:translate(7px,-3px)}50%{transform:translate(5px,7px)}75%{transform:translate(-6px,6px)}}
  @keyframes eye-path{0%,100%{left:0}50%{left:calc(100% - 6px)}}
  @keyframes drop-pulse{0%,100%{transform:rotate(45deg) translate(0,0);opacity:.65}50%{transform:rotate(45deg) translate(3px,3px);opacity:1}}
  @keyframes chart-breathe{0%,100%{stroke-dashoffset:0;opacity:.75}50%{stroke-dashoffset:18;opacity:1}}

  @media(max-width:700px){
    .project-preview{aspect-ratio:1.7/1;margin-bottom:18px}
    .preview-caption{font-size:.53rem}
  }

  @media(prefers-reduced-motion:reduce){
    .preview-scene,.preview-scene::after,.phone-scan,.signal-ring,.eye-iris i,.eye-path span,.water-drop,.chart-line{animation:none!important;transition:none!important}
    .project-card:hover .preview-scene,.project-card.is-pointed .preview-scene{transform:none}
  }
</style>
