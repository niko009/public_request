---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const statusRu = project.status === 'Active' ? 'Активен' : project.status === 'In development' ? 'В разработке' : 'Прототип';
const canonicalProjectUrl = `https://bacus.dev/projects/${project.slug}/`;
const relatedProjects = projects.filter((item) => item.slug !== project.slug).slice(0, 3);
const sameAs = [project.liveUrl, project.githubUrl].filter(Boolean);

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.name,
  description: project.summaryRu,
  url: canonicalProjectUrl,
  keywords: project.stack.join(', '),
  isPartOf: {
    '@type': 'WebSite',
    name: 'bacus.dev',
    url: 'https://bacus.dev/'
  },
  ...(sameAs.length ? { sameAs } : {})
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://bacus.dev/' },
    { '@type': 'ListItem', position: 2, name: 'Проекты', item: 'https://bacus.dev/projects/' },
    { '@type': 'ListItem', position: 3, name: project.name, item: canonicalProjectUrl }
  ]
};
---
<BaseLayout
  title={`${project.name} — bacus.dev`}
  description={project.summaryRu}
  pageType="article"
  schema={[projectSchema, breadcrumbSchema]}
>
  <section class="section shell page-intro project-detail reveal">
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="/" data-en="Home" data-ru="Главная">Главная</a>
      <span aria-hidden="true">/</span>
      <a href="/projects/" data-en="Projects" data-ru="Проекты">Проекты</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{project.name}</span>
    </nav>

    <div class="eyebrow" data-en={project.status} data-ru={statusRu}>{statusRu}</div>
    <h1 style={`view-transition-name: project-${project.slug}`}>{project.name}</h1>
    <p class="project-summary" data-en={project.summaryEn} data-ru={project.summaryRu}>{project.summaryRu}</p>

    <div class="detail-actions">
      {project.liveUrl && <a class="button primary" href={project.liveUrl} target="_blank" rel="noreferrer" data-en="Open project ↗" data-ru="Открыть проект ↗">Открыть проект ↗</a>}
      {project.githubUrl && <a class="button secondary" href={project.githubUrl} target="_blank" rel="noreferrer" aria-label={`GitHub — ${project.name}`}>GitHub ↗</a>}
    </div>
  </section>

  <section class="section shell project-detail-body" aria-labelledby="about-project">
    <div class="detail-grid stagger-grid">
      <article class="detail-card">
        <div class="eyebrow" data-en="About" data-ru="О проекте">О проекте</div>
        <h2 class="sr-only" id="about-project" data-en={`About ${project.name}`} data-ru={`О проекте ${project.name}`}>О проекте {project.name}</h2>
        <p data-en={project.descriptionEn} data-ru={project.descriptionRu}>{project.descriptionRu}</p>
      </article>
      <article class="detail-card">
        <div class="eyebrow" data-en="Stack" data-ru="Технологии">Технологии</div>
        <h2 class="sr-only" data-en="Technologies" data-ru="Технологии">Технологии</h2>
        <div class="tags detail-tags">{project.stack.map((item) => <span>{item}</span>)}</div>
      </article>
    </div>
  </section>

  <section class="section shell related-projects" aria-labelledby="related-projects-title">
    <div class="related-head">
      <div>
        <div class="eyebrow" data-en="Continue exploring" data-ru="Другие проекты">Другие проекты</div>
        <h2 id="related-projects-title" data-en="More from the lab." data-ru="Ещё из лаборатории.">Ещё из лаборатории.</h2>
      </div>
      <a class="text-link" href="/projects/" data-en="All projects →" data-ru="Все проекты →">Все проекты →</a>
    </div>
    <div class="related-grid">
      {relatedProjects.map((item) => (
        <a class="related-card" href={`/projects/${item.slug}/`}>
          <small>{item.status === 'Active' ? 'ACTIVE' : item.status === 'Prototype' ? 'PROTOTYPE' : 'IN DEVELOPMENT'}</small>
          <strong>{item.name}</strong>
          <span data-en={item.summaryEn} data-ru={item.summaryRu}>{item.summaryRu}</span>
          <b aria-hidden="true">↗</b>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
<style>
  .project-detail{max-width:920px}
  .breadcrumbs{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:26px;color:var(--muted);font-size:.78rem}
  .breadcrumbs a{transition:color .2s ease}.breadcrumbs a:hover{color:var(--text)}
  .breadcrumbs span[aria-current='page']{color:var(--text)}
  .project-summary{max-width:760px;font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.7}
  .detail-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
  .project-detail-body{padding-top:0}
  .detail-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(260px,.7fr);gap:18px}
  .detail-card{border:1px solid var(--line);border-radius:24px;padding:26px;background:var(--panel)}
  .detail-card p{color:var(--muted);line-height:1.75;margin:14px 0 0}
  .detail-tags{margin-top:16px}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .related-projects{padding-top:28px}
  .related-head{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:24px}.related-head h2{margin:10px 0 0}
  .related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
  .related-card{position:relative;display:flex;min-height:210px;flex-direction:column;padding:22px;border:1px solid var(--line);border-radius:20px;background:var(--panel);transition:transform .3s var(--ease-out),border-color .2s ease}
  .related-card:hover{transform:translateY(-3px);border-color:var(--line-strong)}
  .related-card small{color:var(--accent2);font-size:.58rem;letter-spacing:.12em}.related-card strong{margin:16px 0 10px;font-size:1.35rem}.related-card>span{color:var(--muted);font-size:.82rem;line-height:1.55}.related-card b{position:absolute;right:18px;top:18px;color:var(--accent)}
  @media(max-width:760px){.detail-grid,.related-grid{grid-template-columns:1fr}.detail-actions .button{width:100%}.related-head{align-items:flex-start;flex-direction:column}}
</style>
