---
import '../styles/global.css';

const {
  title = 'bacus.dev — продукты, эксперименты и ИИ',
  description = 'Личная лаборатория программных продуктов, экспериментов с ИИ и технологий, которые просто интересно попробовать.',
  ogImage = '/og-image.svg',
  pageType = 'website',
  schema = null
} = Astro.props;

// Production version: increment this for every published site change.
const siteVersion = '0.4.1';
const versionedLogo = `/logo-mark.svg?v=${siteVersion}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImageURL = new URL(ogImage, Astro.site ?? Astro.url.origin);
const isHome = Astro.url.pathname === '/';
const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'bacus.dev',
  url: 'https://bacus.dev/',
  description: 'Личная лаборатория программных продуктов, экспериментов с ИИ и технологий.'
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'bacus.dev',
  url: 'https://bacus.dev/',
  logo: 'https://bacus.dev/logo-mark.svg',
  description: 'Личная лаборатория продуктов, технических экспериментов и идей с ИИ.',
  sameAs: ['https://github.com/niko009']
};

const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const schemas = [...(isHome ? [siteSchema] : []), organizationSchema, ...extraSchemas];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content="bacus.dev" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#07070b" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="bacus.dev" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content="bacus.dev — продукты, эксперименты и ИИ" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href={versionedLogo} type="image/svg+xml" sizes="any" />
    <link rel="shortcut icon" href={versionedLogo} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={versionedLogo} />
    <title>{title}</title>
    {schemas.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const savedLang = localStorage.getItem('lang');
      const resolvedTheme = savedTheme || 'dark';
      document.documentElement.dataset.theme = resolvedTheme;
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', resolvedTheme === 'light' ? '#f6f7fb' : '#07070b');
      if (savedLang) document.documentElement.lang = savedLang;
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content" data-en="Skip to content" data-ru="Перейти к содержимому">Перейти к содержимому</a>
    <div class="page-progress" id="page-progress" aria-hidden="true"></div>

    <header class="site-header">
      <a class="brand" href="/" aria-label="bacus.dev — главная">
        <span class="brand-mark" aria-hidden="true"><img src={versionedLogo} width="35" height="35" alt="" style="display:block;width:100%;height:100%" /></span>
        <span class="brand-word">bacus<span>.dev</span></span>
      </a>
      <span class="header-signature" data-en="Personal lab" data-ru="Личная лаборатория">Личная лаборатория</span>
      <nav class="nav" aria-label="Основная навигация">
        {isHome ? (
          <>
            <a href="#projects" data-en="Projects" data-ru="Проекты">Проекты</a>
            <a href="#process" data-en="Process" data-ru="Процесс">Процесс</a>
            <a href="#stack" data-en="Stack" data-ru="Стек">Стек</a>
            <a href="#lab" data-en="Lab" data-ru="Лаборатория">Лаборатория</a>
          </>
        ) : (
          <>
            <a href="/" aria-current={isActive('/') ? 'page' : undefined} data-en="Home" data-ru="Главная">Главная</a>
            <a href="/projects/" aria-current={isActive('/projects/') ? 'page' : undefined} data-en="Projects" data-ru="Проекты">Проекты</a>
            <a href="/about/" aria-current={isActive('/about/') ? 'page' : undefined} data-en="About" data-ru="Обо мне">Обо мне</a>
          </>
        )}
      </nav>
      <div class="controls">
        <button class="ghost" id="lang-toggle" type="button" aria-label="Switch language to English">EN</button>
        <button class="ghost theme-toggle" id="theme-toggle" type="button" aria-label="Переключить цветовую тему" title="Переключить тему"><span aria-hidden="true">◐</span></button>
        <button class="menu-toggle" id="menu-toggle" type="button" aria-label="Открыть меню" aria-controls="mobile-menu" aria-expanded="false"><span></span></button>
      </div>
    </header>

    <div class="mobile-menu" id="mobile-menu" aria-hidden="true" inert>
      <nav class="mobile-nav" aria-label="Мобильная навигация">
        {isHome ? (
          <>
            <a href="#projects"><small>01</small><span data-en="Projects" data-ru="Проекты">Проекты</span></a>
            <a href="#process"><small>02</small><span data-en="Process" data-ru="Процесс">Процесс</span></a>
            <a href="#stack"><small>03</small><span data-en="Stack" data-ru="Стек">Стек</span></a>
            <a href="#lab"><small>04</small><span data-en="Lab" data-ru="Лаборатория">Лаборатория</span></a>
          </>
        ) : (
          <>
            <a href="/"><small>01</small><span data-en="Home" data-ru="Главная">Главная</span></a>
            <a href="/projects/"><small>02</small><span data-en="Projects" data-ru="Проекты">Проекты</span></a>
            <a href="/about/"><small>03</small><span data-en="About" data-ru="Обо мне">Обо мне</span></a>
          </>
        )}
      </nav>
      <div class="mobile-bottom">
        <span>bacus.dev</span>
        <span data-en="Build · Explore · Learn" data-ru="Создавать · Пробовать · Учиться">Создавать · Пробовать · Учиться</span>
      </div>
    </div>

    <main id="main-content" tabindex="-1"><slot /></main>

    <footer class="footer">
      <div class="footer-brand">
        <strong>bacus.dev</strong>
        <span
          data-en={`Personal product & AI lab · Version v${siteVersion}`}
          data-ru={`Личная лаборатория продуктов и ИИ · Версия v${siteVersion}`}
        >Личная лаборатория продуктов и ИИ · Версия v{siteVersion}</span>
        <small>© 2026 bacus.dev</small>
      </div>
      <div class="footer-links">
        <a href="https://github.com/niko009" rel="noreferrer">GitHub ↗</a>
        <a href="mailto:mihail@bacus.dev">Email ↗</a>
        <a href="/privacy/" data-en="Privacy" data-ru="Конфиденциальность">Конфиденциальность</a>
      </div>
    </footer>

    <style is:global>
      .skip-link{
        position:fixed;
        left:16px;
        top:10px;
        z-index:200;
        padding:11px 14px;
        border-radius:10px;
        background:var(--text);
        color:var(--bg);
        font-weight:800;
        transform:translateY(-160%);
        transition:transform .2s var(--ease-out);
      }
      .skip-link:focus{transform:translateY(0)}
      .nav a,.ghost,.menu-toggle{min-height:44px}
      .nav a{display:inline-flex;align-items:center}
      .ghost{height:44px}
      .footer-brand small{display:block;margin-top:6px;color:var(--muted);font-size:.68rem}
      #main-content:focus{outline:none}
    </style>

    <script is:inline>
      (() => {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const finePointer = matchMedia('(hover:hover) and (pointer:fine)').matches;

        const applyLanguage = (lang) => {
          document.documentElement.lang = lang;
          document.querySelectorAll('[data-en][data-ru]').forEach((el) => {
            el.textContent = el.dataset[lang] || el.textContent;
          });
          document.querySelectorAll('[data-en-aria-label][data-ru-aria-label]').forEach((el) => {
            const value = el.dataset[`${lang}AriaLabel`];
            if (value) el.setAttribute('aria-label', value);
          });
          const button = document.getElementById('lang-toggle');
          if (button) {
            button.textContent = lang === 'en' ? 'RU' : 'EN';
            button.setAttribute('aria-label', lang === 'en' ? 'Переключить язык на русский' : 'Switch language to English');
          }
        };

        applyLanguage(localStorage.getItem('lang') || 'ru');

        document.querySelectorAll('.hero-type h1,.kinetic-heading,.cap-grid h2,.final-inner h2').forEach((container) => {
          if (container.dataset.semanticSpacingDone === 'true') return;
          const directSpans = [...container.children].filter((child) => child.tagName === 'SPAN');
          directSpans.slice(0, -1).forEach((span) => span.after(document.createTextNode(' ')));
          container.dataset.semanticSpacingDone = 'true';
        });

        document.getElementById('lang-toggle')?.addEventListener('click', () => {
          const lang = document.documentElement.lang === 'en' ? 'ru' : 'en';
          localStorage.setItem('lang', lang);
          applyLanguage(lang);
        });

        document.getElementById('theme-toggle')?.addEventListener('click', () => {
          const theme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
          document.documentElement.dataset.theme = theme;
          localStorage.setItem('theme', theme);
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'light' ? '#f6f7fb' : '#07070b');
        });

        const menuButton = document.getElementById('menu-toggle');
        const menu = document.getElementById('mobile-menu');
        const setMenu = (open) => {
          menuButton?.setAttribute('aria-expanded', String(open));
          menuButton?.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
          menu?.setAttribute('aria-hidden', String(!open));
          if (menu) menu.inert = !open;
          menu?.classList.toggle('open', open);
          document.body.classList.toggle('menu-open', open);
          if (open) menu?.querySelector('a')?.focus();
          else if (document.activeElement && menu?.contains(document.activeElement)) menuButton?.focus();
        };

        menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
        menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
        document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenu(false); });

        const animated = [...document.querySelectorAll('.reveal,.stagger-grid>*')];
        if (reduce || !('IntersectionObserver' in window)) {
          animated.forEach((el) => el.classList.add('is-visible'));
        } else {
          const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }), { threshold: .12, rootMargin: '0px 0px -5%' });

          animated.forEach((el, index) => {
            if (el.parentElement?.classList.contains('stagger-grid')) el.style.setProperty('--reveal-delay', `${(index % 4) * 70}ms`);
            observer.observe(el);
          });
        }

        const progress = document.getElementById('page-progress');
        const scrollTimelineSupported = typeof CSS !== 'undefined' && CSS.supports?.('animation-timeline: scroll()');
        if (progress && !reduce && !scrollTimelineSupported) {
          let ticking = false;
          const updateProgress = () => {
            const max = document.documentElement.scrollHeight - innerHeight;
            const ratio = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
            progress.style.transform = `scaleX(${ratio})`;
            ticking = false;
          };
          const requestProgress = () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(updateProgress);
          };
          addEventListener('scroll', requestProgress, { passive: true });
          addEventListener('resize', requestProgress, { passive: true });
          updateProgress();
        }

        if (finePointer && !reduce) {
          let pointerFrame = 0;
          addEventListener('pointermove', (event) => {
            if (pointerFrame) return;
            pointerFrame = requestAnimationFrame(() => {
              document.documentElement.style.setProperty('--pointer-x', `${event.clientX}px`);
              document.documentElement.style.setProperty('--pointer-y', `${event.clientY}px`);
              pointerFrame = 0;
            });
          }, { passive: true });

          document.querySelectorAll('[data-tilt-card]').forEach((card) => {
            let frame = 0;
            const update = (event) => {
              if (frame) cancelAnimationFrame(frame);
              frame = requestAnimationFrame(() => {
                const rect = card.getBoundingClientRect();
                const x = (event.clientX - rect.left) / rect.width;
                const y = (event.clientY - rect.top) / rect.height;
                card.style.setProperty('--spot-x', `${x * 100}%`);
                card.style.setProperty('--spot-y', `${y * 100}%`);
                card.style.setProperty('--card-ry', `${(x - .5) * 5}deg`);
                card.style.setProperty('--card-rx', `${(.5 - y) * 5}deg`);
                card.classList.add('is-pointed');
              });
            };
            const reset = () => {
              if (frame) cancelAnimationFrame(frame);
              card.style.setProperty('--card-ry', '0deg');
              card.style.setProperty('--card-rx', '0deg');
              card.classList.remove('is-pointed');
            };
            card.addEventListener('pointermove', update, { passive: true });
            card.addEventListener('pointerleave', reset, { passive: true });
          });
        }
      })();
    </script>
  </body>
</html>