---
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredProjects, projects } from '../data/projects';

const liveCount = projects.filter((project) => Boolean(project.liveUrl)).length;
const inDevCount = projects.filter((project) => project.status === 'In development').length;
const technologyCount = new Set(projects.flatMap((project) => project.stack)).size;

const projectAccents: Record<string, string> = {
  'motion-play': '#00e5cc',
  nutriguru: '#7dd3fc',
  'eye-gym': '#fbbf24',
  'san-teh': '#f472b6',
  alcocalc: '#a78bfa',
};

const statusRu = (status: string) => status === 'Active' ? 'live' : status === 'Prototype' ? 'prototype' : 'dev';

const processSteps = [
  { num: '01', icon: '◇', titleRu: 'Идея', titleEn: 'Idea', textRu: 'Зацепка, раздражение или «а что если».', textEn: 'A hook, an itch, or a what-if.' },
  { num: '02', icon: '✦', titleRu: 'Промпт', titleEn: 'Prompt', textRu: 'Формулирую задачу ИИ: контекст, рамки, результат.', textEn: 'Frame the task for AI: context, constraints, outcome.' },
  { num: '03', icon: '</>', titleRu: 'Сборка', titleEn: 'Build', textRu: 'Код, правки, деплой. Я направляю и принимаю.', textEn: 'Code, fixes, deploy. I steer and accept.' },
  { num: '04', icon: '↗', titleRu: 'URL', titleEn: 'URL', textRu: 'Свой адрес. Можно открыть и пользоваться.', textEn: 'Its own URL. Open it and use it.' },
];

const techGroups = [
  { icon: '✦', title: 'AI', items: ['Идеи', 'Код', 'UI', 'Критика', 'Контент', 'Автоматизация'] },
  { icon: '{ }', title: 'Backend', items: ['ASP.NET Core', 'APIs', 'PostgreSQL', 'RabbitMQ', 'MassTransit'] },
  { icon: '↗', title: 'Запуск', items: ['Docker', 'CI/CD', 'Cloudflare', 'Portable hosting'] },
  { icon: '◎', title: 'Движение и веб', items: ['MediaPipe', 'WebRTC', 'PWA', 'React', 'Next.js', 'Android'] },
];
---
<BaseLayout
  title="bacus.dev — идея → ИИ → URL"
  description="Идеи, которые ИИ собирает и публикует. Можно открыть и пользоваться."
>
  <div class="upload-home" id="top">
    <div class="lab-background" aria-hidden="true">
      <div class="lab-grid"></div>
      <canvas id="hero-3d-canvas" class="hero-3d-canvas" aria-hidden="true"></canvas>
      <span class="glow-orb glow-one"></span>
      <span class="glow-orb glow-two"></span>
      <span class="glow-orb glow-three"></span>
      <div class="lab-vignette"></div>
    </div>
    <div class="custom-cursor" id="custom-cursor" aria-hidden="true"><i></i></div>

    <section class="upload-hero upload-shell noise">
      <div class="hero-pill hero-animate">
        <span class="hero-live-dot"></span>
        <span>idea → ai → url</span>
      </div>

      <h1 class="hero-title" aria-label="Придумал. Отдал ИИ. Открыл в браузере.">
        <span class="word">Придумал.</span>
        <span class="word accent-word">Отдал ИИ.</span>
        <span class="word">Открыл</span>
        <span class="word">в браузере.</span>
      </h1>

      <p class="hero-copy hero-animate">
        <strong>bacus.dev</strong> — журнал запусков: идея уходит в ИИ, на выходе появляется то, чем можно пользоваться. Код я понимаю, но основной цикл здесь другой — сформулировать, направить, принять результат.
      </p>

      <div class="hero-actions hero-animate">
        <a class="btn-primary" href="#projects">Смотреть проекты <span>↓</span></a>
        <a class="btn-ghost" href="#process">Как это устроено</a>
      </div>

      <div class="hero-metrics hero-animate">
        <div><strong>{projects.length}</strong><span>проектов</span></div>
        <div><strong>{liveCount}</strong><span>онлайн</span></div>
        <div><strong>{technologyCount}+</strong><span>технологий</span></div>
      </div>

      <a class="scroll-cue" href="#projects" aria-label="Перейти к проектам"><span>scroll</span><i></i></a>
    </section>

    <section class="upload-section upload-shell" id="projects">
      <div class="section-heading reveal-item">
        <span class="section-label">// 01 — запуски</span>
        <h2>Уже можно <span>открыть.</span></h2>
        <p>Каждый проект начинался с мысли. Дальше — промпт, сборка, деплой. Что-то полезное, что-то странное — у всего свой URL.</p>
      </div>

      <div class="projects-grid">
        {featuredProjects.map((project, index) => (
          <article class="project-card reveal-item" style={`--accent:${projectAccents[project.slug] ?? '#00e5cc'};--delay:${index * 80}ms`}>
            <a class="project-card-main" href={`/projects/${project.slug}/`} style={`view-transition-name: project-preview-${project.slug}`}>
              <div class="card-orb"></div>
              <div class="card-top">
                <span class="project-initial">{project.name.charAt(0)}</span>
                <span class={`status-badge ${project.status === 'Active' ? 'live' : 'dev'}`}><i></i>{statusRu(project.status)}</span>
              </div>
              <h3 style={`view-transition-name: project-${project.slug}`}>{project.name}</h3>
              <p class="project-tagline">{project.summaryRu}</p>
              <div class="project-tags">{project.stack.slice(0, 3).map((tag) => <span>{tag}</span>)}</div>
              <div class="open-hint">Подробнее <span>↗</span></div>
            </a>
            {project.liveUrl && <a class="live-strip" href={project.liveUrl} target="_blank" rel="noreferrer">Открыть живой проект <span>↗</span></a>}
          </article>
        ))}

        <a class="project-card all-projects reveal-item" href="/projects/">
          <span class="plus">+</span>
          <strong>Все запуски</strong>
          <small>{projects.length} на сайте</small>
          <span class="all-arrow">↗</span>
        </a>
      </div>
    </section>

    <section class="upload-section upload-shell" id="process">
      <div class="section-heading reveal-item">
        <span class="section-label">// 02 — цикл</span>
        <h2>Идея → промпт → <span>URL.</span></h2>
        <p>Не «ИИ вместо меня», а «ИИ как исполнитель». Я выбираю задачу и критерии, модель пишет и собирает, я решаю, что оставить в сети.</p>
      </div>

      <div class="process-wrap reveal-item">
        <div class="process-line" aria-hidden="true"><span></span></div>
        <div class="process-grid">
          {processSteps.map((step, index) => (
            <article class="process-card" style={`--delay:${index * 120}ms`}>
              <div class="process-top"><span class="process-icon">{step.icon}</span><b>{step.num}</b></div>
              <h3 data-en={step.titleEn} data-ru={step.titleRu}>{step.titleRu}</h3>
              <p data-en={step.textEn} data-ru={step.textRu}>{step.textRu}</p>
              <i class="process-dot" aria-hidden="true"></i>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="upload-section upload-shell" id="lab">
      <div class="section-heading reveal-item">
        <span class="section-label">// 03 — сейчас</span>
        <h2>Сколько уже <span>дошло до URL.</span></h2>
      </div>

      <div class="stats-grid">
        <article class="stat-card reveal-item"><strong data-counter={projects.length}>0</strong><span>Проектов</span></article>
        <article class="stat-card reveal-item"><strong data-counter={liveCount}>0</strong><span>Онлайн</span></article>
        <article class="stat-card reveal-item"><strong data-counter={inDevCount}>0</strong><span>В разработке</span></article>
        <article class="stat-card reveal-item"><strong data-counter={technologyCount} data-suffix="+">0</strong><span>Технологий</span></article>
      </div>
    </section>

    <section class="upload-section upload-shell" id="stack">
      <div class="section-heading reveal-item">
        <span class="section-label">// 04 — стек</span>
        <h2>Чем это <span>собирается.</span></h2>
      </div>

      <div class="tech-grid">
        {techGroups.map((group) => (
          <article class="tech-card reveal-item">
            <div class="tech-title"><span>{group.icon}</span><h3>{group.title}</h3></div>
            <div class="tech-items">{group.items.map((item) => <span>{item}</span>)}</div>
          </article>
        ))}
      </div>
    </section>

    <section class="lab-finale upload-shell reveal-item">
      <h2>Не портфолио. <span>Журнал запусков.</span></h2>
      <p>Новые идеи появляются, старые пересобираются. Здесь остаётся только то, что дошло до адреса и открывается в браузере.</p>
      <div class="finale-links">
        <a href="/projects/">Все запуски ↗</a>
        <a href="/about/">Как устроено ↗</a>
        <a href="https://github.com/niko009" target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
      <div class="refine-line">idea → ai → url</div>
    </section>
  </div>

  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap');

    body:has(.upload-home){background:#07070b;color:#f0f0f5;font-family:Inter,ui-sans-serif,system-ui,sans-serif}
    body:has(.upload-home)::before,body:has(.upload-home)::after{display:none}
    body:has(.upload-home) .site-header{position:fixed;top:0;left:0;right:0;width:100%;margin:0;padding:18px max(24px,calc((100vw - 1152px)/2));border:0;border-radius:0;background:rgba(7,7,11,.36);box-shadow:none;backdrop-filter:blur(18px);transition:background .35s ease,padding .35s ease,border-color .35s ease}
    body:has(.upload-home) .site-header.is-scrolled{padding-top:12px;padding-bottom:12px;background:rgba(14,14,24,.74);border-bottom:1px solid rgba(74,74,99,.22)}
    body:has(.upload-home) .brand-mark{background:transparent;border:0;box-shadow:none;width:32px;height:32px}
    body:has(.upload-home) .brand-word{font-family:'Space Grotesk',sans-serif;color:#f0f0f5}
    body:has(.upload-home) .brand-word span{color:#00e5cc}
    body:has(.upload-home) .header-signature{display:none}
    body:has(.upload-home) .nav a{color:#9a9ab0;background:transparent;font-size:.82rem}
    body:has(.upload-home) .nav a:hover,body:has(.upload-home) .nav a[aria-current='page']{color:#00e5cc;background:transparent}
    body:has(.upload-home) .ghost{border-color:#252538;background:rgba(18,18,30,.45);color:#c8c8d8}
    body:has(.upload-home) .footer{background:#07070b;border-top:1px solid rgba(74,74,99,.24);color:#c8c8d8}
    body:has(.upload-home) .footer a{color:#9a9ab0}

    /* Light theme — home */
    :root[data-theme='light'] body:has(.upload-home){background:#f4f7fb;color:#111827}
    :root[data-theme='light'] body:has(.upload-home) .site-header{background:rgba(244,247,251,.72);border-bottom-color:rgba(16,24,40,.08)}
    :root[data-theme='light'] body:has(.upload-home) .site-header.is-scrolled{background:rgba(255,255,255,.88);border-bottom:1px solid rgba(16,24,40,.1)}
    :root[data-theme='light'] body:has(.upload-home) .brand-word{color:#111827}
    :root[data-theme='light'] body:has(.upload-home) .brand-word span{color:#0d9f8c}
    :root[data-theme='light'] body:has(.upload-home) .nav a{color:#617085}
    :root[data-theme='light'] body:has(.upload-home) .nav a:hover,:root[data-theme='light'] body:has(.upload-home) .nav a[aria-current='page']{color:#0d9f8c}
    :root[data-theme='light'] body:has(.upload-home) .ghost{border-color:rgba(16,24,40,.12);background:rgba(255,255,255,.7);color:#334155}
    :root[data-theme='light'] body:has(.upload-home) .footer{background:#f4f7fb;border-top-color:rgba(16,24,40,.1);color:#617085}
    :root[data-theme='light'] body:has(.upload-home) .footer a{color:#617085}
    :root[data-theme='light'] .upload-home{--ink:#f4f7fb;--ink-soft:#edf2f8;--panel:rgba(255,255,255,.72);--panel-hover:rgba(255,255,255,.9);--line:rgba(16,24,40,.12);--text:#111827;--muted:#617085;--dim:#94a3b8;--accent:#0d9f8c;--warn:#d97706;background:#f4f7fb;color:var(--text)}
    :root[data-theme='light'] .lab-background{background:#f4f7fb}
    :root[data-theme='light'] .lab-grid{background-image:linear-gradient(rgba(16,24,40,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(16,24,40,.04) 1px,transparent 1px)}
    :root[data-theme='light'] .lab-vignette{background:radial-gradient(ellipse at top,transparent 0%,rgba(244,247,251,.4) 66%,#f4f7fb 100%)}
    :root[data-theme='light'] .glow-one{background:rgba(13,159,140,.12)}
    :root[data-theme='light'] .glow-two{background:rgba(13,159,140,.08)}
    :root[data-theme='light'] .hero-title .word{background:linear-gradient(110deg,#111827 15%,#0d9f8c 60%,#111827);background-clip:text;-webkit-background-clip:text}
    :root[data-theme='light'] .hero-title .accent-word{background:linear-gradient(90deg,#0d9f8c,#14b8a6);background-clip:text;-webkit-background-clip:text}
    :root[data-theme='light'] .hero-copy{color:#617085}
    :root[data-theme='light'] .hero-copy strong{color:#0d9f8c}
    :root[data-theme='light'] .hero-pill{background:rgba(255,255,255,.75);border-color:rgba(16,24,40,.1);color:#617085}
    :root[data-theme='light'] .btn-primary{background:#0d9f8c;border-color:#0d9f8c;color:#fff}
    :root[data-theme='light'] .btn-primary:hover{background:#0f766e;box-shadow:0 0 28px rgba(13,159,140,.25)}
    :root[data-theme='light'] .btn-ghost{border-color:rgba(16,24,40,.12);color:#334155;background:rgba(255,255,255,.6)}
    :root[data-theme='light'] .btn-ghost:hover{border-color:rgba(13,159,140,.4);color:#0d9f8c;background:rgba(13,159,140,.06)}
    :root[data-theme='light'] .hero-metrics div,:root[data-theme='light'] .project-card,:root[data-theme='light'] .process-card,:root[data-theme='light'] .stat-card,:root[data-theme='light'] .tech-card{background:rgba(255,255,255,.78);border-color:rgba(16,24,40,.1)}
    :root[data-theme='light'] .project-card:hover,:root[data-theme='light'] .process-card:hover,:root[data-theme='light'] .stat-card:hover,:root[data-theme='light'] .tech-card:hover{border-color:rgba(13,159,140,.35);background:rgba(255,255,255,.95)}
    :root[data-theme='light'] .section-label{color:rgba(13,159,140,.75)}
    :root[data-theme='light'] .section-heading h2 span,:root[data-theme='light'] .lab-finale h2 span{background:linear-gradient(90deg,#0d9f8c,#14b8a6);background-clip:text;-webkit-background-clip:text}
    :root[data-theme='light'] .section-heading p,:root[data-theme='light'] .project-tagline,:root[data-theme='light'] .process-card p,:root[data-theme='light'] .lab-finale p{color:#617085}
    :root[data-theme='light'] .project-card h3,:root[data-theme='light'] .process-card h3,:root[data-theme='light'] .tech-title h3{color:#111827}
    :root[data-theme='light'] .stat-card strong{background:linear-gradient(100deg,#111827,#0d9f8c);background-clip:text;-webkit-background-clip:text}
    :root[data-theme='light'] .hero-3d-canvas.is-ready{opacity:.55}
    :root[data-theme='light'] .custom-cursor{border-color:rgba(13,159,140,.45)}
    :root[data-theme='light'] .custom-cursor i{background:#0d9f8c}

    .upload-home{--ink:#07070b;--ink-soft:#0e0e18;--panel:rgba(14,14,24,.58);--panel-hover:rgba(18,18,30,.74);--line:rgba(74,74,99,.38);--text:#f0f0f5;--muted:#9a9ab0;--dim:#6b6b85;--accent:#00e5cc;--warn:#ffb347;position:relative;isolation:isolate;overflow:hidden;background:#07070b;color:var(--text);font-family:Inter,ui-sans-serif,system-ui,sans-serif}
    .upload-shell{width:min(1152px,calc(100% - 48px));margin-inline:auto}
    .lab-background{position:fixed;inset:0;z-index:-4;overflow:hidden;pointer-events:none;background:#07070b}
    .lab-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.028) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.028) 1px,transparent 1px);background-size:40px 40px;animation:grid-shift 22s linear infinite}
    .hero-3d-canvas{position:absolute;inset:0;width:100%;height:100%;opacity:0;transition:opacity 1s ease;pointer-events:none;z-index:0}
    .hero-3d-canvas.is-ready{opacity:1}
    .glow-orb{position:absolute;border-radius:50%;filter:blur(80px);opacity:.72;will-change:transform}
    .glow-one{width:500px;height:500px;top:5%;left:-120px;background:rgba(0,229,204,.11)}
    .glow-two{width:430px;height:430px;right:-100px;bottom:10%;background:rgba(0,138,120,.14)}
    .glow-three{width:300px;height:300px;top:50%;left:48%;background:rgba(255,179,71,.045)}
    .lab-vignette{position:absolute;inset:0;background:radial-gradient(ellipse at top,transparent 0%,rgba(7,7,11,.35) 66%,#07070b 100%)}

    .upload-hero{position:relative;min-height:760px;padding:150px 0 90px;display:flex;flex-direction:column;justify-content:center}
    .noise::before{content:"";position:absolute;inset:0;opacity:.025;pointer-events:none;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitchTiles'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")}
    .hero-pill{width:max-content;display:flex;align-items:center;gap:9px;margin-bottom:30px;padding:8px 13px;border:1px solid rgba(74,74,99,.42);border-radius:999px;background:rgba(14,14,24,.58);backdrop-filter:blur(18px);color:#9a9ab0;font:500 .68rem 'JetBrains Mono',monospace;letter-spacing:.035em}
    .hero-live-dot{width:8px;height:8px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px rgba(0,229,204,.6);animation:glow-pulse 3s ease-in-out infinite}
    .hero-title{max-width:900px;margin:0;font-family:'Space Grotesk',sans-serif;font-size:clamp(2.9rem,6.4vw,5.8rem);line-height:1.08;letter-spacing:-.045em;font-weight:700;text-wrap:balance}
    .hero-title .word{display:inline-block;margin-right:.22em;color:transparent;background:linear-gradient(110deg,#f0f0f5 20%,#c8fff4 55%,#f0f0f5);background-clip:text;-webkit-background-clip:text;opacity:0;filter:blur(8px);transform:translateY(24px);animation:word-in .65s cubic-bezier(.22,1,.36,1) forwards}
    .hero-title .word:nth-child(2){animation-delay:.1s}.hero-title .word:nth-child(3){animation-delay:.2s}.hero-title .word:nth-child(4){animation-delay:.3s}
    .hero-title .accent-word{background:linear-gradient(90deg,#00e5cc,#80ffe2);background-clip:text;-webkit-background-clip:text}
    .hero-copy{max-width:720px;margin:32px 0 0;color:#9a9ab0;font-size:1.05rem;line-height:1.75}.hero-copy strong{color:#00e5cc;font-weight:600}
    .hero-actions{display:flex;gap:13px;flex-wrap:wrap;margin-top:34px}.btn-primary,.btn-ghost{min-height:48px;padding:0 21px;border-radius:12px;display:inline-flex;align-items:center;gap:9px;font-weight:600;font-size:.86rem;position:relative;transition:transform .25s cubic-bezier(.22,1,.36,1),border-color .3s ease,box-shadow .3s ease,background .3s ease;will-change:transform}.btn-primary{background:#00e5cc;color:#07070b;border:1px solid #00e5cc}.btn-primary:hover{background:#1affcb;box-shadow:0 0 34px rgba(0,229,204,.25)}.btn-ghost{border:1px solid #252538;color:#c8c8d8;background:rgba(18,18,30,.3)}.btn-ghost:hover{border-color:rgba(0,229,204,.4);color:#00e5cc;background:rgba(0,229,204,.045)}
    .hero-metrics{display:flex;gap:10px;flex-wrap:wrap;margin-top:38px}.hero-metrics div{min-width:118px;padding:12px 14px;border:1px solid rgba(74,74,99,.28);border-radius:12px;background:rgba(14,14,24,.36);backdrop-filter:blur(12px)}.hero-metrics strong{display:block;font-family:'Space Grotesk',sans-serif;font-size:1.15rem}.hero-metrics span{display:block;margin-top:2px;color:#6b6b85;font:500 .58rem 'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.08em}
    .hero-animate{opacity:0;transform:translateY(18px);animation:fade-up .6s cubic-bezier(.22,1,.36,1) forwards .85s}.hero-actions{animation-delay:1.05s}.hero-metrics{animation-delay:1.2s}
    .scroll-cue{position:absolute;left:50%;bottom:22px;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:8px;color:#4a4a63;font:500 .55rem 'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.16em}.scroll-cue i{width:1px;height:42px;background:linear-gradient(#00e5cc80,transparent);animation:scroll-line 2s ease-in-out infinite}

    .upload-section{padding:96px 0;border-top:1px solid rgba(74,74,99,.16)}
    .section-heading{max-width:800px;margin-bottom:50px}.section-label{display:block;color:rgba(0,229,204,.65);font:500 .63rem 'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.18em}.section-heading h2{margin:15px 0 0;font-family:'Space Grotesk',sans-serif;font-size:clamp(2.35rem,4.4vw,4.3rem);line-height:1.05;letter-spacing:-.05em}.section-heading h2 span{color:transparent;background:linear-gradient(90deg,#00e5cc,#80ffe2);background-clip:text;-webkit-background-clip:text}.section-heading p{max-width:650px;margin:18px 0 0;color:#9a9ab0;font-size:.9rem;line-height:1.7}

